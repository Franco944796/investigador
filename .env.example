# Copiar a .env y completar. En Render estos valores se cargan en el panel (ver render.yaml).

# Personas que pueden entrar: nombre:código[:límite diario], separadas por coma.
# El código lleva 8 caracteres o más. Límite 0 = sin límite; si se omite vale LIMITE_DIARIO.
CODIGOS_ACCESO=franco:cambiar-este-codigo:0
LIMITE_DIARIO=5

PUERTO=3210
# 0.0.0.0 para aceptar conexiones de afuera (servidor publicado).
HOST=127.0.0.1
# Cantidad de proxies inversos delante del servidor (0 = ninguno). Hace falta para la cookie
# segura y para ver la IP real de quien entra.
CONFIAR_EN_PROXY=0

# Proveedores de modelos (compatibles con OpenAI), en orden de preferencia, del 1 al 9. Si uno
# se queda sin cupo o falla, se pasa al siguiente. Los que no tienen clave se ignoran.
# Los nombres de modelos cambian seguido: revisarlos en la web de cada proveedor. Varios modelos
# separados por coma se prueban en orden con la misma clave.
LLM_1_URL=https://integrate.api.nvidia.com/v1
LLM_1_CLAVE=
LLM_1_MODELO=nvidia/nemotron-3-ultra-550b-a55b,mistralai/mistral-large-4-1t-a52b,openai/gpt-oss-20b,z-ai/glm-5.3-flash

LLM_2_URL=https://api.groq.com/openai/v1
LLM_2_CLAVE=
LLM_2_MODELO=openai/gpt-oss-120b

LLM_3_URL=https://api.mistral.ai/v1
LLM_3_CLAVE=
LLM_3_MODELO=mistral-small-latest

LLM_4_URL=https://openrouter.ai/api/v1
LLM_4_CLAVE=
LLM_4_MODELO=nvidia/nemotron-3-ultra-550b-a55b:free

# Alternativa: un único endpoint compatible con OpenAI. Solo se usa si ningún proveedor de
# arriba tiene clave.
# LLM_URL_BASE=http://localhost:8080/v1
# LLM_CLAVE=
# LLM_MODELO=auto

# Tiempo máximo de espera por pedido a un modelo, en minutos.
# LLM_LIMITE_MINUTOS=30

# Cadena de conexión de Postgres (Neon) para guardar el historial. Vacía = en memoria: se
# pierde al reiniciar.
DATABASE_URL=

# Dirección pública del servidor. Render la da sola (RENDER_EXTERNAL_URL); mientras haya una
# investigación en curso, el servidor se visita cada 10 min para que Render no lo duerma.
# URL_PUBLICA=

# Clave de tavily.com. Vacía = solo DuckDuckGo.
TAVILY_CLAVE=

# Profundidad de cada investigación (valores por defecto).
# CONSULTAS_INICIALES=5
# RESULTADOS_POR_CONSULTA=4
# RONDAS_EXTRA=2
# MAX_FUENTES=24
# INVESTIGACIONES_SIMULTANEAS=2
